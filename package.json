{
  "name": "breastfeeding-decision-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A guided quiz for working up breastfeeding difficulty. Educational; for clinicians.",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "validate": "node scripts/validate-content.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "screenshots": "npm run build && node scripts/screenshots.mjs",
    "map": "node scripts/content-map.mjs"
  },
  "dependencies": {
    "mermaid": "^11.17.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "happy-dom": "^20.11.8",
    "playwright": "^1.62.1",
    "prettier": "^3.9.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
